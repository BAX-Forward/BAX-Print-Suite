{
  "name": "@bax-print/printer-mock",
  "version": "0.1.0",
  "description": "Mock PrinterDriver/1 plugin for BAX Print Suite: a separate process speaking BPP over stdio",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "bps-printer-mock": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./bps-plugin.json": "./bps-plugin.json"
  },
  "files": [
    "dist",
    "bps-plugin.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bax-print/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
