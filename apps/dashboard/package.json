{
  "name": "@bax-print/dashboard",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "msw init public --no-save && vite --mode mock",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:mock": "playwright test",
    "gen:api": "openapi-typescript mock/openapi.json -o src/api/schema.ts",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.20",
    "@tanstack/react-table": "8.20.5",
    "@tanstack/react-virtual": "3.10.9",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.17.1",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "msw": "2.6.5",
    "openapi-typescript": "7.4.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
