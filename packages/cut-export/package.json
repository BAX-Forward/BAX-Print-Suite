{
  "name": "@bax-print/cut-export",
  "version": "0.1.0",
  "description": "Vendor-neutral cut export: frame transforms, HPGL, DXF R12 and layered PDF writers, CutterDriver/2 job validation and panel segmentation",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bax-print/plugin-sdk": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "dxf-parser": "1.1.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
