{
  "name": "@bax-print/tile",
  "version": "0.0.0",
  "private": true,
  "description": "Split oversized artwork into printable, nestable and cuttable panels (Spec 009)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "fast-check": "3.23.2",
    "pdfjs-dist": "5.3.31",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
